{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/qwen-local",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "provider": {
    "local": {
      "options": {
        "baseURL": "http://127.0.0.1:30000/v1",
        "apiKey": "dummy"
      },
      "models": {
        "qwen-local": {
          "limit": {
            "context": 110000,
            "input": 85000,
            "output": 25000
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "variants": {
            "low": {
              "reasoningEffort": "low"
            },
            "medium": {
              "reasoningEffort": "medium"
            },
            "xhigh": {
              "reasoningEffort": "xhigh"
            }
          }
        }
      }
    }
  }
}